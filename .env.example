# Public app setting. Add this only when Cedar's client portal URL is available.
VITE_CLIENT_APP_URL=

# Public Supabase settings used by the private admin sign-in and RLS client.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel server-side settings. Never expose the service role key or Resend key
# through a VITE_ variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CARE_REQUEST_RECIPIENT=cedarhealthcarehome@gmail.com
PUBLIC_SITE_URL=https://www.cedarhealthcarehome.com
EMAIL_LOGO_URL=https://www.cedarhealthcarehome.com/cedar-logo.jpeg
